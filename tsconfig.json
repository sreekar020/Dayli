{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.js",
    "**/*.jsx",
    ".expo/types/**/*.js",
    "expo-env.d.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/app/index.tsx",
    "src/app/authentication/auth.tsx",
    "src/app/_layout.tsx",
    "src/components/ui/styles.tsx",
    "src/app/(tabs)/index.tsx"
  ]
}
